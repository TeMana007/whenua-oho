{
  "expo": {
    "name": "Kōrero Companion",
    "slug": "korero-companion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#162d4a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.korero.companion"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#162d4a"
      },
      "package": "com.korero.companion"
    },
    "plugins": ["expo-router", "expo-av"],
    "scheme": "korero"
  }
}
